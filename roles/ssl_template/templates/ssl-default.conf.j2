# 自动生成的 nginx 模板（auto-safe-vps）
# 关键点：默认 server 拒绝直接 IP 访问 80/443，避免 SSL 证书泄露源站
# nginx >= 1.19.4 支持 ssl_reject_handshake on;

# 1. 默认服务器：直接 IP 访问 -> 拒绝握手
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 444;
}

# 2. 真实业务站点
server {
    listen 80;
    server_name {{ ssl_template.domain }};
    location /.well-known/acme-challenge/ { root {{ ssl_template.webroot }}; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name {{ ssl_template.domain }};

    ssl_certificate     /etc/nginx/ssl/{{ ssl_template.domain }}.crt;
    ssl_certificate_key /etc/nginx/ssl/{{ ssl_template.domain }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # TODO: 业务反向代理配置（按需补全）
    # location / { proxy_pass http://127.0.0.1:8080; }
}
